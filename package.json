{
  "name": "big-gacha",
  "version": "1.0.0",
  "description": "Big Gacha — base de données perso multi-jeux gacha (Genshin Impact, Honkai: Star Rail, Wuthering Waves)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/supervisor.js",
    "test": "node --test",
    "backup": "node src/scripts/backup.js",
    "restore": "node src/scripts/backup.js restore",
    "sync": "node src/scripts/sync.js",
    "sync:dry": "node src/scripts/sync.js --dry-run",
    "sync:rollback": "node src/scripts/sync.js --rollback",
    "seed:genshin": "node src/scripts/seedGenshin.js",
    "seed:genshin:force": "node src/scripts/seedGenshin.js --force",
    "seed:hsr": "node src/scripts/seedHsr.js",
    "seed:hsr:force": "node src/scripts/seedHsr.js --force",
    "enrich:hsr": "node src/scripts/hsrWikiEnrich.js",
    "enrich:hsr:force": "node src/scripts/hsrWikiEnrich.js --force",
    "seed:wuwa": "node src/scripts/seedWuwa.js",
    "client:dev": "npm run dev --prefix client",
    "dev:all": "concurrently \"npm run dev\" \"npm run client:dev\"",
    "enhancements:reload": "node -e \"fetch('http://127.0.0.1:5000/api/enhancements/reload',{method:'POST',headers:{'X-Big-Gacha':'1'}}).then(r=>r.json()).then(j=>console.log(JSON.stringify(j.data,null,2)))\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "genshin-db": "^5.2.14",
    "js-yaml": "^5.4.3",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "sharp": "^0.34.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "mongodb-memory-server": "^11.0.1",
    "nodemon": "^3.1.9"
  },
  "keywords": [
    "genshin",
    "hsr",
    "zzz",
    "wuthering-waves",
    "endfield",
    "gacha",
    "database",
    "api"
  ],
  "author": "David",
  "license": "MIT"
}
